{
  "name": "chaipalaka-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "chaipalaka.com — Vite + React + TypeScript frontend, statically generated via vite-react-ssg.",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-fallback-pngs.mjs",
    "build": "vite-react-ssg build",
