{
    "name": "chaipalaka-web",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "description": "chaipalaka.com — Vite + React + TypeScript frontend, statically generated via vite-react-ssg.",
    "scripts": {
        "dev": "vite",
        "prebuild": "node scripts/generate-fallback-pngs.mjs",
        "build": "vite-react-ssg build",
        "build:vite": "vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "simple-git-hooks"
    },
    "simple-git-hooks": {
        "pre-commit": "cd web && npx lint-staged"
    },
    "lint-staged": {
        "*.{ts,tsx,css,json,mjs}": "prettier --write"
    },
    "dependencies": {
        "@chenglou/pretext": "^0.0.6",
        "@fontsource-variable/inter": "^5.2.8",
        "@fontsource-variable/jetbrains-mono": "^5.2.8",
        "@fontsource-variable/newsreader": "^5.2.10",
        "@fontsource/ibm-plex-mono": "^5.2.7",
        "@fontsource/ibm-plex-sans": "^5.2.8",
        "@mdx-js/rollup": "^3.1.1",
        "@react-three/fiber": "^9.6.1",
        "estree-util-value-to-estree": "^3.5.0",
        "github-slugger": "^2.0.0",
        "gray-matter": "^4.0.3",
        "matter-js": "^0.20.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-router-dom": "^6.30.0",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-pretty-code": "^0.14.3",
        "rehype-slug": "^6.0.0",
        "remark-frontmatter": "^5.0.0",
        "remark-mdx-frontmatter": "^5.2.0",
        "remark-mdx-images": "^3.0.0",
        "shiki": "^4.0.2",
        "three": "^0.184.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/matter-js": "^0.20.2",
        "@types/node": "^25.6.2",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@types/three": "^0.184.1",
        "@vitejs/plugin-react": "^4.7.0",
        "happy-dom": "^20.9.0",
        "lint-staged": "^17.0.4",
        "prettier": "^3.8.3",
        "sharp": "^0.34.5",
        "simple-git-hooks": "^2.13.1",
        "typescript": "^5.9.3",
        "vite": "^7.3.3",
        "vite-react-ssg": "^0.9.1-beta.1",
        "vitest": "^3.2.4"
    }
}
